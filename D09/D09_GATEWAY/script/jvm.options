# =====================================================================
# D08_CONF_JVM_LLT JVM 启动参数（JDK 21）
# 加载方式：java @jvm.options -jar app.jar
# 说明：本文件为「参数文件(argfile)」，# 开头为注释，一个参数一行；
#       相对路径（logs/...）以启动脚本设定的工作目录（模块根目录）为准。
#       每个参数后均给出「作用」，避免无意义堆砌。
# =====================================================================

# ---------------------------------------------------------------------
# 一、堆内存（Heap）
# ---------------------------------------------------------------------

# 初始堆大小：设置为 256m，让 JVM 启动即预留，避免运行期频繁扩容造成停顿。
-Xms256m

# 最大堆大小：本地演示限制在 512m，防止异常内存占用拖垮本机；
# 生产环境应结合容器内存与压测结果设置（容器内建议配合 -XX:MaxRAMPercentage）。
-Xmx512m

# ---------------------------------------------------------------------
# 二、垃圾收集器（Garbage Collector, GC）
# ---------------------------------------------------------------------

# 显式指定 G1 垃圾收集器（Garbage-First）。JDK 21 在服务端默认即为 G1，
# 这里显式声明以保证各环境一致；G1 面向多核、大堆，兼顾吞吐量与可预测停顿。
-XX:+UseG1GC

# G1 字符串去重：将内容相同的 String 底层 byte[] 合并存储，降低堆占用；
# 仅在 G1 下生效，会带来少量 CPU 开销，适合存在大量重复字符串的业务。
-XX:+UseStringDeduplication

# ---------------------------------------------------------------------
# 三、GC 日志（JDK 9+ 统一日志框架 -Xlog；已替代旧的 -XX:+PrintGCDetails）
# ---------------------------------------------------------------------

# 输出所有 gc* 相关日志到文件 logs/gc/gc.log：
#   time,uptime,level,tags —— 日志包含绝对时间、启动相对时间、级别、标签；
#   filecount=10,filesize=20M —— 单文件 20M，最多保留 10 个滚动文件。
-Xlog:gc*:file=logs/gc/gc.log:time,uptime,level,tags:filecount=10,filesize=20M

# ---------------------------------------------------------------------
# 四、内存溢出（OutOfMemoryError, OOM）故障排查
# ---------------------------------------------------------------------

# OOM 时自动生成堆转储（heap dump，.hprof），用于事后分析大对象与泄漏点。
-XX:+HeapDumpOnOutOfMemoryError

# 堆转储输出目录（脚本会确保该目录存在）；文件名默认含进程号与时间戳。
-XX:HeapDumpPath=logs/heapdump

# OOM 发生后立即终止 JVM：避免进程在内存耗尽后“半存活”继续对外提供错误服务。
# 与 HeapDumpOnOutOfMemoryError 配合时，先导出转储再退出。
-XX:+ExitOnOutOfMemoryError

# 元空间（Metaspace，存储类元数据）上限：约束动态类加载，防止类加载器泄漏耗尽本地内存。
-XX:MaxMetaspaceSize=256m

# 单线程栈大小：默认 1m，这里设 512k，在深调用不多的服务中可减少每线程内存占用。
-Xss512k

# ---------------------------------------------------------------------
# 五、本地内存跟踪（Native Memory Tracking, NMT）
# ---------------------------------------------------------------------

# 开启 NMT 汇总级别，可通过 jcmd <pid> VM.native_memory summary 查看堆外、
# 元空间、线程栈等本地内存分布，用于排查 Direct buffer / Metaspace 问题；
# 有轻微性能开销，生产环境如不需要可关闭（默认 off）。
-XX:NativeMemoryTracking=summary
