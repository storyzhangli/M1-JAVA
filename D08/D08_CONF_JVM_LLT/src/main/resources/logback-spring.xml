<?xml version="1.0" encoding="UTF-8"?>
<!--
  Logback 日志配置（Spring Boot 3.x / Logback）
  关键点：日志 pattern 中通过 %X{traceId} 输出 MDC 中的 traceId，
          使同一次请求（含异步线程）的日志可通过 traceId 关联。
  说明：相对路径 logs/... 以启动脚本设定的工作目录（模块根目录）为准。
-->
<configuration>

    <property name="LOG_HOME" value="logs/app"/>

    <!-- 控制台 pattern：带颜色，traceId 取自 MDC，缺失时显示为空 -->
    <property name="CONSOLE_PATTERN"
              value="%d{yyyy-MM-dd HH:mm:ss.SSS} %highlight(%-5level) [%thread] [traceId=%X{traceId}] %cyan(%logger{40}) - %msg%n"/>

    <!-- 文件 pattern：不含颜色，便于检索与采集 -->
    <property name="FILE_PATTERN"
              value="%d{yyyy-MM-dd HH:mm:ss.SSS} %-5level [%thread] [traceId=%X{traceId}] %logger{40} - %msg%n"/>

    <!-- 控制台输出 -->
    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>${CONSOLE_PATTERN}</pattern>
            <charset>UTF-8</charset>
        </encoder>
    </appender>

    <!-- 滚动文件：按天 + 大小切分，保留 30 天，总量上限 3GB -->
    <appender name="FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${LOG_HOME}/app.log</file>
        <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
            <fileNamePattern>${LOG_HOME}/app.%d{yyyy-MM-dd}.%i.log</fileNamePattern>
            <maxFileSize>100MB</maxFileSize>
            <maxHistory>30</maxHistory>
            <totalSizeCap>3GB</totalSizeCap>
        </rollingPolicy>
        <encoder>
            <pattern>${FILE_PATTERN}</pattern>
            <charset>UTF-8</charset>
        </encoder>
    </appender>

    <root level="INFO">
        <appender-ref ref="CONSOLE"/>
        <appender-ref ref="FILE"/>
    </root>
</configuration>
